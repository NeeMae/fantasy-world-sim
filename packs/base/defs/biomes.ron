// Biomes are chosen per hex from three climate values:
//
//   elevation    percentile: 0.55 means 55% of the world is lower
//   moisture     percentile: 0.30 means 30% of the world is drier
//   temperature  0.0 = polar, 1.0 = equatorial (cooler with altitude)
//
// The matching biome with the highest `priority` wins. Ranges default to
// "anything", so a biome only needs to state what makes it special.
//
// Hills and mountains are relief (see reliefs.ron), layered on top, so a
// hex can be forested hills or desert mountains. Biomes can also ask for a
// relief and a `massif`: how great the mountain range is, from 0 (none, or
// old worn-down ranges like the Appalachians) to 1 (great collision ranges
// like the Himalaya). Small ranges keep the biome of the land around them;
// great ones get their own.
//
// Moisture comes from simulated rainfall: winds carry it in from the sea,
// and mountains wring it out, leaving dry rain shadows in their lee.
(
    biomes: [
        // ---- Water ---------------------------------------------------------
        (id: "water_base", abstract: true, water: true, elevation: (0.0, 0.55)),

        (id: "deep_ocean", parent: "water_base", name: "Deep Ocean", color: "#1d335e",
            elevation: (0.0, 0.33)),
        (id: "ocean", parent: "water_base", name: "Ocean", color: "#27508a",
            elevation: (0.33, 0.5)),
        (id: "shallows", parent: "water_base", name: "Shallows", color: "#3a6fae",
            elevation: (0.5, 0.55)),
        (id: "sea_ice", parent: "water_base", name: "Sea Ice", color: "#c9dbe6",
            temperature: (0.0, 0.07), priority: 5),

        // ---- Land ----------------------------------------------------------
        (id: "land_base", abstract: true, water: false, elevation: (0.55, 1.0)),

        (id: "grassland", parent: "land_base", name: "Grassland", color: "#7aa64a"),
        (id: "forest", parent: "land_base", name: "Forest", color: "#3e7432",
            temperature: (0.3, 0.72), moisture: (0.55, 1.0), priority: 1),
        (id: "taiga", parent: "land_base", name: "Taiga", color: "#335a46",
            temperature: (0.16, 0.3), moisture: (0.35, 1.0), priority: 1),
        (id: "tundra", parent: "land_base", name: "Tundra", color: "#8b9a86",
            temperature: (0.0, 0.16), priority: 1),
        (id: "glacier", parent: "land_base", name: "Glacier", color: "#e9f0f4",
            temperature: (0.0, 0.06), priority: 2),
        (id: "savanna", parent: "land_base", name: "Savanna", color: "#b3a24c",
            temperature: (0.62, 1.0), moisture: (0.25, 0.55), priority: 1),
        (id: "desert", parent: "land_base", name: "Desert", color: "#d9c27e",
            temperature: (0.55, 1.0), moisture: (0.0, 0.25), priority: 1),
        (id: "jungle", parent: "land_base", name: "Jungle", color: "#2a7232",
            temperature: (0.72, 1.0), moisture: (0.6, 1.0), priority: 2),
        (id: "swamp", parent: "land_base", name: "Swamp", color: "#536b49",
            elevation: (0.55, 0.6), moisture: (0.85, 1.0), temperature: (0.35, 1.0), priority: 3),

        // ---- Great ranges --------------------------------------------------
        (id: "mountain_base", abstract: true, parent: "land_base", relief: ["mountains"],
            massif: (0.35, 1.0), priority: 6),

        // Wet, temperate ranges: high meadows and conifers (the Alps).
        (id: "alpine", parent: "mountain_base", name: "Alpine", color: "#7f9471",
            moisture: (0.3, 1.0), temperature: (0.12, 0.75)),
        // Dry ranges: bare rock and scree (the Rockies' rain-shadow side).
        (id: "crags", parent: "mountain_base", name: "Crags", color: "#8c7d6c",
            moisture: (0.0, 0.3)),
        // The roof of the world (the Himalaya).
        (id: "snowy_peaks", parent: "mountain_base", name: "Snowy Peaks", color: "#e6ebef",
            massif: (0.6, 1.0), temperature: (0.0, 0.3), priority: 7),

    ],
)
